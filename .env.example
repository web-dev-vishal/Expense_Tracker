# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=5000
NODE_ENV=development

# ==========================================
# DATABASE
# ==========================================
DATABASE_URL=mongodb://localhost:27017/Expense_Tracker
# For production (MongoDB Atlas):
# DATABASE_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/Expense_Tracker

# ==========================================
# JWT AUTHENTICATION
# ==========================================
JWT_SECRET=your_strong_jwt_secret_key_minimum_32_characters

# ==========================================
# REDIS CONFIGURATION
# ==========================================
REDIS_URL=redis://localhost:6379
# For production (Upstash / Render Redis):
# REDIS_URL=rediss://<user>:<password>@<host>:<port>

# ==========================================
# RABBITMQ CONFIGURATION
# ==========================================
RABBITMQ_USER=admin
RABBITMQ_PASS=admin123
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=expense_tracker
# For production (CloudAMQP):
# RABBITMQ_HOST=<your-cloudamqp-host>
# RABBITMQ_VHOST=<your-vhost>

# ==========================================
# EMAIL CONFIGURATION (Gmail)
# ==========================================
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
# Note: Use Gmail App Password, not your regular password
# Generate at: https://myaccount.google.com/apppasswords